# Backend API Base URL
# In local development: http://localhost:5000
# In production: https://your-backend-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Maps API Key — required for the SOS live map
# Create one at: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API + Map IDs (for Advanced Markers)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
