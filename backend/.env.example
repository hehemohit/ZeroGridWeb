# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas SRV connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_EXPIRES_IN=7d

# Google OAuth — required for POST /api/auth/google (Checkpoint 1)
# Get from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Firebase Cloud Messaging — required for SOS push notifications (Checkpoint 3)
# Base64-encode your Firebase Admin SDK service account JSON:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('./serviceAccount.json')).toString('base64'))"
# Then paste the result here.
FCM_SERVER_KEY=your_base64_encoded_firebase_service_account_json